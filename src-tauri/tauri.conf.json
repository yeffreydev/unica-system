{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Aqui Nace",
  "version": "0.1.0",
  "identifier": "com.unica.system",
  "build": {
    "frontendDist": "../out",
    "devUrl": "http://localhost:3000",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Aqui Nace",
        "width": 1280,
        "height": 800,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "../../server/dist-sidecar/unica-sidecar"
    ],
    "resources": {
      "../../server/dist-sidecar/payload/**/*": "payload/"
    }
  }
}
